{
  "name": "mini_netsentinel",
  "private": true,
  "version": "0.1.0",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:exe": "node scripts/convert-icon.cjs && tsc && vite build && electron-packager . NetSentinel_Portable --platform=win32 --arch=x64 --icon=public/icon.ico --out=dist_portable --overwrite",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "build": {
    "appId": "com.hyunm.netsentinel",
    "productName": "NetSentinel_Portable",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "d3-scale": "^4.0.2",
    "lucide-react": "^1.29.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.2.8",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "to-ico": "^1.1.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
