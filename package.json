{
  "name": "netsentinel",
  "productName": "NetSentinel",
  "private": true,
  "version": "0.1.0",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build:electron": "node scripts/sync-ipc-channels.cjs && tsc -p tsconfig.electron.json",
    "prepare": "npm run build:electron",
    "build": "npm run build:electron && tsc && vite build",
    "build:exe": "node scripts/test-telemetry.cjs && node scripts/download-geoip.cjs && npm run build:electron && tsc && vite build && node scripts/build-portable.cjs",
    "audit:wiring": "node scripts/audit-wiring.cjs",
    "audit:offline": "node scripts/audit-wiring.cjs --offline",
    "test": "node --test scripts/test/*.test.cjs",
    "clean:build": "node scripts/clean-old-builds.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "koffi": "^3.1.4",
    "lucide-react": "^1.29.0",
    "maxmind": "^5.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.4.0",
    "electron-packager": "^17.1.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "allowScripts": {
    "koffi@3.1.4": true
  }
}
